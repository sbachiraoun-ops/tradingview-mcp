//@version=6
// ============================================================================
//  RSI-2 MEAN REVERSION (indices swing) — PF-tuned
// ----------------------------------------------------------------------------
//  Larry Connors' 2-period RSI edge with a modern risk overlay.
//  Long-only dip-buying inside an uptrend (the historically proven side).
//
//  ENTRY  : close > 200-SMA  AND  RSI(2) < threshold  (default 5 = high PF)
//  EXIT   : close > fast SMA (mean reached)  OR  RSI(2) > 65  OR  time-stop
//  STOP   : 2.5 x ATR(10) below entry (wide on purpose — mean-reversion stops
//           get hit right before the snapback)
//  SIZE   : fixed % -equity risk per trade
//
//  Levers to push profit factor toward / above 2:
//    - lower "RSI buy threshold" (5 -> 3)         : fewer, higher-quality dips
//    - raise "Min consecutive lower closes" (0->2): only buy real flushes
//    - widen "Stop = ATR x" (2.5 -> 3.0)          : fewer premature stop-outs
//  Best market: NAS100 / US500 / US30 (or QQQ/SPY), Daily or 4H.
// ============================================================================
strategy("RSI-2 Mean Reversion — PF-tuned", overlay=true, initial_capital=100000,
     pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
     commission_type=strategy.commission.cash_per_contract, commission_value=2.0, slippage=2)

// ── Entry ─────────────────────────────────────────────────────────────────────
gE       = "Entry"
rsiLen   = input.int(2,   "RSI length", group=gE)
buyTh    = input.float(5, "RSI buy threshold (<)", step=1, group=gE)
trendLen = input.int(200, "Trend SMA (only buy above)", group=gE)
needDown = input.int(0,   "Min consecutive lower closes (0=off)", minval=0, group=gE)

// ── Exit ──────────────────────────────────────────────────────────────────────
gX        = "Exit"
useSMAexit= input.bool(true, "Exit on close > fast SMA", group=gX)
smaExit   = input.int(5,     "Fast SMA", group=gX)
useRSIexit= input.bool(true, "Exit on RSI > level", group=gX)
exitRSI   = input.float(65,  "RSI exit level", group=gX)
useTime   = input.bool(true, "Use time stop", group=gX)
maxBars   = input.int(10,    "Max bars in trade", minval=1, group=gX)

// ── Risk ──────────────────────────────────────────────────────────────────────
gR      = "Risk"
riskPct = input.float(1.0, "Risk % of equity per trade", minval=0.1, step=0.1, group=gR)
atrLen  = input.int(10,    "ATR length", group=gR)
atrMult = input.float(2.5, "Stop = ATR x", minval=0.5, step=0.25, group=gR)

// ── Signals ───────────────────────────────────────────────────────────────────
trendOK = close > ta.sma(close, trendLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

var int downCount = 0
downCount := close < close[1] ? downCount + 1 : 0
downOK    = needDown <= 0 or downCount >= needDown

longSig = trendOK and rsi < buyTh and downOK

var float slPrice  = na
var int   entryBar = na
riskUSD = strategy.equity * riskPct / 100.0

// ── Entry ─────────────────────────────────────────────────────────────────────
if longSig and strategy.position_size == 0
    sl   = close - atrMult * atr
    dist = close - sl
    if dist > 0
        qty = math.max(1, math.floor(riskUSD / (dist * syminfo.pointvalue)))
        strategy.entry("L", strategy.long, qty=qty)
        slPrice  := sl
        entryBar := bar_index

// ── Manage / exit ─────────────────────────────────────────────────────────────
if strategy.position_size > 0
    strategy.exit("sl", "L", stop=slPrice)
    exitMean = (useSMAexit and close > ta.sma(close, smaExit)) or (useRSIexit and rsi > exitRSI)
    timeOut  = useTime and not na(entryBar) and (bar_index - entryBar >= maxBars)
    if exitMean or timeOut
        strategy.close("L", comment = exitMean ? "mean" : "time")

plot(ta.sma(close, trendLen), "Trend SMA", color=color.new(color.orange, 0))
plotshape(longSig and strategy.position_size == 0, "Buy", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.tiny)
