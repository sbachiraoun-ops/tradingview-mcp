//@version=6
// ============================================================================
//  RSI-2 MEAN REVERSION — explicit ENTRY / STOP-LOSS / TAKE-PROFIT
// ----------------------------------------------------------------------------
//  ENTRY : close > 200-SMA  AND  RSI(2) < threshold (default 5)
//  STOP  : entry - (ATR x SL mult)              <-- explicit SL price
//  TARGET: entry + (R multiple x risk)          <-- explicit TP price
//  SIZE  : % of equity per trade (always affordable -> always fills)
//  Best market: NAS100 / US500 / US30 / XAUUSD, 5m–Daily.
// ============================================================================
strategy("RSI-2 Mean Reversion — Entry/SL/TP", overlay=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
     commission_type=strategy.commission.percent, commission_value=0.02, slippage=2)

// ── Entry ─────────────────────────────────────────────────────────────────────
gE       = "Entry"
rsiLen   = input.int(2,   "RSI length", group=gE)
buyTh    = input.float(5, "RSI buy threshold (<)", step=1, group=gE)
trendLen = input.int(200, "Trend SMA (buy only above)", group=gE)

// ── Stop-Loss & Take-Profit (explicit) ────────────────────────────────────────
gT     = "Stop-Loss / Take-Profit"
atrLen = input.int(10,    "ATR length", group=gT)
slMult = input.float(2.5, "STOP-LOSS = ATR x", minval=0.25, step=0.25, group=gT)
tpMode = input.string("R-multiple", "TAKE-PROFIT mode", options=["R-multiple","ATR multiple"], group=gT)
rr     = input.float(1.5, "Take-Profit (R multiple)", minval=0.25, step=0.25, group=gT)
tpAtr  = input.float(3.0, "Take-Profit (ATR x)", minval=0.25, step=0.25, group=gT)
useTime= input.bool(true, "Time stop (safety exit)", group=gT)
maxBars= input.int(10,    "Max bars in trade", minval=1, group=gT)

// ── Sizing is set by default_qty_value above (% of equity per trade) ──────────

// ── Signal ────────────────────────────────────────────────────────────────────
trendOK = close > ta.sma(close, trendLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)
longSig = trendOK and rsi < buyTh

var float slPrice  = na
var float tpPrice  = na
var int   entryBar = na

// ── ENTRY + attach explicit SL and TP ─────────────────────────────────────────
if longSig and strategy.position_size == 0
    sl  = close - slMult * atr
    tp  = tpMode == "R-multiple" ? close + rr * (close - sl) : close + tpAtr * atr
    if close - sl > 0
        strategy.entry("Long", strategy.long)
        strategy.exit("Exit", "Long", stop=sl, limit=tp)   // <-- SL + TP bracket
        slPrice  := sl
        tpPrice  := tp
        entryBar := bar_index

// ── Safety time-stop ──────────────────────────────────────────────────────────
if strategy.position_size > 0 and useTime and not na(entryBar) and (bar_index - entryBar >= maxBars)
    strategy.close("Long", comment="time")

// ── Draw entry / SL / TP so they're visible on the chart ──────────────────────
inTrade = strategy.position_size > 0
plot(inTrade ? slPrice : na, "STOP-LOSS",   color=color.red,   style=plot.style_linebr, linewidth=2)
plot(inTrade ? tpPrice : na, "TAKE-PROFIT", color=color.green, style=plot.style_linebr, linewidth=2)
plot(inTrade ? strategy.position_avg_price : na, "Entry", color=color.gray, style=plot.style_linebr, linewidth=1)
plot(ta.sma(close, trendLen), "Trend SMA", color=color.new(color.orange, 0))
plotshape(longSig and strategy.position_size == 0, "Buy", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.tiny)
